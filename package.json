{
  "name": "gmaps-scraper",
  "version": "1.0.0",
  "description": "Scraper de leads do Google Maps (nome, telefone, email) via Playwright, exposto como API HTTP para uso no n8n",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "scrape:cli": "node src/cli.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pino": "^9.4.0",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.47.0"
  },
  "engines": {
    "node": ">=18"
  }
}
