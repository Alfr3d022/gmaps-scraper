PORT=3000
HEADLESS=true

# Delay aleatório entre ações, em ms — nunca deixe isso fixo/baixo demais
DELAY_MIN_MS=2500
DELAY_MAX_MS=6000

MAX_RESULTS_PER_QUERY=120
NAVIGATION_TIMEOUT_MS=30000

# Buscar email visitando o site de cada lugar (true/false)
ENRICH_EMAIL=true

# Protege o endpoint HTTP — o n8n deve enviar esse valor no header x-api-key
API_KEY=

# Proxy residencial, formato: http://usuario:senha@host:porta
# Sem proxy funciona para volume baixo; em volume alto o IP vai ser bloqueado rápido.
PROXY_URL=
